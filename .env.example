# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会进仓库。

PORT=5173

# 1 = 只走本地缓存（演示兜底，零 API 成本）；0 = 调真实接口
DEMO_MODE=1

# 接口失败时自动降级到缓存（演示日建议 1）
DEMO_FALLBACK=1

# openai = OpenAI 兼容（DeepSeek / 百炼 / Moonshot / 本地 vLLM 都是这个）
# anthropic = Anthropic 协议（官方或 CC Switch 本地代理）
AI_PROTOCOL=openai
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=45000

# 仅 anthropic 协议需要：x-api-key 或 bearer（CC Switch 代理用 bearer）
AI_AUTH_HEADER=x-api-key
